using module ..\_Base\M365DSCResourceBase.psm1

[DscResource()]
class EXOTransportConfig : M365DSCResourceBase
{
    [DscProperty(Key)]
    [System.ComponentModel.Description('Specifies the resource is a single instance, the value must be ''Yes''.')]
    [ValidateSet('Yes')]
    [System.String] $IsSingleInstance

    [DscProperty()]
    [System.ComponentModel.Description('The AddressBookPolicyRoutingEnabled parameter controls how recipients are resolved in an organization that uses address book policies to create separate virtual organizations within the same Exchange organization.')]
    [System.Nullable[System.Boolean]] $AddressBookPolicyRoutingEnabled

    [DscProperty()]
    [System.ComponentModel.Description('Allow legacy TLS clients')]
    [System.Nullable[System.Boolean]] $AllowLegacyTLSClients

    [DscProperty()]
    [System.ComponentModel.Description('The ClearCategories parameter keeps or removes Microsoft Outlook message categories during content conversion.')]
    [System.Nullable[System.Boolean]] $ClearCategories

    [DscProperty()]
    [System.ComponentModel.Description('The ConvertDisclaimerWrapperToEml parameter specifies whether the original message will be added as a TNEF attachment or a regular EML attachment to a disclaimer.')]
    [System.Nullable[System.Boolean]] $ConvertDisclaimerWrapperToEml

    [DscProperty()]
    [System.ComponentModel.Description('The DSNConversionMode parameter controls how Exchange handles delivery status notifications that are generated by earlier versions of Exchange or other messaging systems.')]
    [System.String] $DSNConversionMode

    [DscProperty()]
    [System.ComponentModel.Description('The ExternalDelayDsnEnabled parameter specifies whether a delay delivery status notification (DSN) message should be created for external messages that couldn''t be immediately delivered. ')]
    [System.Nullable[System.Boolean]] $ExternalDelayDsnEnabled

    [DscProperty()]
    [System.ComponentModel.Description('The ExternalDsnDefaultLanguage parameter specifies which Exchange server language should be used by default when you create external DSN messages.')]
    [System.String] $ExternalDsnDefaultLanguage

    [DscProperty()]
    [System.ComponentModel.Description('The ExternalDsnLanguageDetectionEnabled parameter specifies whether the server should try to send an external DSN message in the same language as the original message that generated the notification.')]
    [System.Nullable[System.Boolean]] $ExternalDsnLanguageDetectionEnabled

    [DscProperty()]
    [System.ComponentModel.Description('The ExternalDsnReportingAuthority parameter specifies the domain in the machine-readable part of external DSN messages. ')]
    [System.String] $ExternalDsnReportingAuthority

    [DscProperty()]
    [System.ComponentModel.Description('The ExternalDsnSendHtml parameter specifies whether external DSN messages should be HTML or plain text.')]
    [System.Nullable[System.Boolean]] $ExternalDsnSendHtml

    [DscProperty()]
    [System.ComponentModel.Description('The ExternalPostmasterAddress parameter specifies the email address in the From header field of an external DSN message.')]
    [System.String] $ExternalPostmasterAddress

    [DscProperty()]
    [System.ComponentModel.Description('The HeaderPromotionModeSetting parameter specifies whether named properties are created for custom X-headers on messages received.')]
    [System.String] $HeaderPromotionModeSetting

    [DscProperty()]
    [System.ComponentModel.Description('The InternalDelayDsnEnabled parameter specifies whether a delay DSN message should be created for messages sent to or from recipients or senders in the same Exchange organization that couldn''t be immediately delivered.')]
    [System.Nullable[System.Boolean]] $InternalDelayDsnEnabled

    [DscProperty()]
    [System.ComponentModel.Description('The InternalDsnDefaultLanguage parameter specifies which Exchange server language should be used by default when you create internal DSN messages.')]
    [System.String] $InternalDsnDefaultLanguage

    [DscProperty()]
    [System.ComponentModel.Description('The InternalDsnLanguageDetectionEnabled parameter specifies whether the server should try to send an internal DSN message in the same language as the original message that generated the notification.')]
    [System.Nullable[System.Boolean]] $InternalDsnLanguageDetectionEnabled

    [DscProperty()]
    [System.ComponentModel.Description('The InternalDsnReportingAuthority parameter specifies the domain in the machine-readable part of internal DSN messages.')]
